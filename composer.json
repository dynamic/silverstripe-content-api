{
    "name": "dynamic/silverstripe-content-api",
    "description": "Content population layer on colymba/silverstripe-restfulapi: atomic page compositions, batch operations, assets and stage-aware reads for SilverStripe 5.2+",
    "license": "BSD-3-Clause",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "rest",
        "api",
        "content",
        "populate",
        "elemental",
        "mcp"
    ],
    "authors": [
        {
            "name": "Dynamic",
            "email": "dev@dynamicagency.com",
            "homepage": "https://www.dynamicagency.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5.2",
        "silverstripe/cms": "^5.2",
        "silverstripe/versioned": "^2.2",
        "silverstripe/asset-admin": "^2.2",
        "colymba/silverstripe-restfulapi": "dev-feature/v5",
        "cweagans/composer-patches": "^2.0"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3",
        "dnadesign/silverstripe-elemental": "^5.2",
        "silverstripe/linkfield": "^4",
        "squizlabs/php_codesniffer": "^3",
        "phpstan/phpstan": "^2",
        "cambis/silverstan": "^2.2",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "dnadesign/silverstripe-elemental": "Required for the page-composition endpoints",
        "silverstripe/linkfield": "Enables structured link payloads on has_one Link relations",
        "dynamic/silverstripe-essentials-tools": "Enables $palette()/$button() color token resolution",
        "dynamic/silverstripe-elemental-templates": "Enables the apply-template endpoint"
    },
    "autoload": {
        "psr-4": {
            "Dynamic\\ContentApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dynamic\\ContentApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1": "1.x-dev",
            "dev-ss5": "ss5.x-dev"
        },
        "project-files-installed": [
            "behat.yml",
            "phpunit.xml.dist"
        ],
        "patches": {
            "colymba/silverstripe-restfulapi": {
                "Fix Member::login()/logout() and DataObject::stat() calls removed in SilverStripe 4+ (silverstripeltd's own feature/cms-6-compatibility branch already has this fix — see docs/en/upstream-issues.md)": "https://raw.githubusercontent.com/dynamic/silverstripe-content-api/ss5/patches/colymba-restfulapi-ss5-removed-methods.patch"
            }
        }
    },
    "scripts": {
        "lint": "vendor/bin/phpcs src/ tests/",
        "lint-clean": "vendor/bin/phpcbf src/ tests/"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "phpstan/extension-installer": true,
            "silverstripe/recipe-plugin": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/silverstripeltd/silverstripe-restfulapi"
        }
    ]
}
